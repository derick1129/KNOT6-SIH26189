# Copy to backend/.env for local (non-Docker) runs.

# "networkx" = zero-infra demo mode, nothing else to configure below.
# "neo4j"    = production-shaped backend; requires a reachable Neo4j 5.x instance.
GRAPH_BACKEND=networkx

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

JWT_SECRET=change-me-in-production-please
JWT_EXPIRY_MINUTES=480

AUTO_SEED_DEMO=true
