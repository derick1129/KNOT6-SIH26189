# Copy to backend/.env for local (non-Docker) runs.

# "networkx" = zero-infra demo mode, nothing else to configure below.
# "neo4j"    = production-shaped backend; requires a reachable Neo4j 5.x instance.
GRAPH_BACKEND=networkx

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# KNOT6 Phase 1 application database (users, investigations, cases,
# evidence metadata, audit log). Defaults to a local SQLite file -- nothing
# to install for the zero-infra path. For the production-shaped Docker
# stack (or to test against real Postgres locally), point this at a
# reachable PostgreSQL 16+ instance instead, e.g.:
#   DATABASE_URL=postgresql+psycopg://knot6:knot6_dev_password@localhost:5432/knot6
DATABASE_URL=sqlite:///./knot6_dev.db

# Local filesystem path for uploaded evidence files (see app/services/storage.py).
EVIDENCE_STORAGE_DIR=./data/evidence

JWT_SECRET=change-me-in-production-please
JWT_EXPIRY_MINUTES=480

AUTO_SEED_DEMO=true

# Case Intelligence / AI Investigation Copilot (optional). Unset by default --
# the deterministic Case Intelligence summary, investigation-scoped search,
# and the Copilot's own deterministic answerer all work fully without this;
# only free-form AI reasoning in POST /api/investigations/{id}/copilot needs
# it, and answers with a clear "not configured" state when it's empty rather
# than faking a response. See backend/app/copilot/llm_provider.py.
#
# Generic, provider-agnostic names -- preferred if set:
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
#
# Vendor-specific names -- still fully supported (used as a fallback when
# the generic ones above are unset), and where the base URL always lives:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
